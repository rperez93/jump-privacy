#!/usr/bin/env bash
# jump-privacy - WSL front end; acts on the Windows host. on | off | toggle | status | auto on|off
set -u
cd /mnt/c || exit 1
lad=$(cmd.exe /c 'echo %LOCALAPPDATA%' 2>/dev/null | tr -d '\r')
powershell.exe -NoProfile -STA -ExecutionPolicy Bypass -File "$lad\\JumpPrivacy\\JumpPrivacy.ps1" "$@" 2>&1 | tr -d '\r'
exit "${PIPESTATUS[0]}"
